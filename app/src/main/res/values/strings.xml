    <!-- Onboarding -->
    <string name="onboarding_step_of">Langkah %1$d dari %2$d</string>
    <string name="onboarding_welcome_title">Jangan lewatkan panggilan darurat</string>
    <string name="onboarding_welcome_body">WakeAlarm membangunkanmu saat pesan WhatsApp penting masuk — bahkan saat HP hening, terkunci, atau kamu sedang tidur.</string>
    <string name="onboarding_feature_keywords_title">Hanya pesan yang penting</string>
    <string name="onboarding_feature_keywords_body">Alarm berbunyi hanya jika pesan berisi kombinasi kata kunci darurat yang kamu pilih.</string>
    <string name="onboarding_feature_loud_title">Keras dan tak terlewat</string>
    <string name="onboarding_feature_loud_body">Menembus mode hening dan layar kunci, dengan volume yang naik bertahap.</string>
    <string name="onboarding_feature_toggle_title">Jeda dengan satu ketukan</string>
    <string name="onboarding_feature_toggle_body">Sedang menangani pasien? Jeda siaga dari notifikasi atau Quick Settings.</string>
    <string name="onboarding_privacy_title">Bagaimana WakeAlarm memakai datamu</string>
    <string name="onboarding_privacy_body">Agar bisa bekerja, WakeAlarm perlu akses ke notifikasi di HP ini. Mohon baca sebelum melanjutkan.</string>
    <string name="onboarding_privacy_read_title">Yang dibaca</string>
    <string name="onboarding_privacy_read_body">Isi dan nama pengirim notifikasi dari WhatsApp dan WhatsApp Business. Notifikasi aplikasi lain diabaikan.</string>
    <string name="onboarding_privacy_device_title">Diproses di HP ini</string>
    <string name="onboarding_privacy_device_body">Pencocokan kata kunci terjadi sepenuhnya di perangkat, tanpa internet.</string>
    <string name="onboarding_privacy_store_title">Yang disimpan</string>
    <string name="onboarding_privacy_store_body">Hanya pesan yang memicu alarm (maksimal 30 terakhir) untuk riwayat. Bisa kamu hapus kapan saja.</string>
    <string name="onboarding_privacy_share_title">Tidak dibagikan</string>
    <string name="onboarding_privacy_share_body">Tidak ada data yang dikirim ke server, pihak ketiga, atau iklan.</string>
    <string name="onboarding_permissions_title">Berikan izin</string>
    <string name="onboarding_permissions_body">Ketuk \"Izinkan\" pada tiap item. Kamu akan dibawa ke pengaturan sistem — kembali ke sini setelah mengaktifkannya.</string>
    <string name="onboarding_done_title">Siap siaga!</string>
    <string name="onboarding_done_body">Semua izin wajib sudah diberikan. Beberapa tips sebelum mulai:</string>
    <string name="onboarding_done_body_incomplete">Masih ada izin wajib yang belum diberikan — kamu bisa melengkapinya nanti dari beranda. Beberapa tips:</string>
    <string name="onboarding_tip_standby_title">Aktifkan mode siaga</string>
    <string name="onboarding_tip_standby_body">Siaga awalnya dijeda. Ketuk kartu besar di beranda untuk mengaktifkannya.</string>
    <string name="onboarding_tip_test_title">Coba tes alarm</string>
    <string name="onboarding_tip_test_body">Pastikan suara dan layar alarm muncul dengan benar di HP-mu.</string>
    <string name="onboarding_tip_tile_title">Tambahkan ke Quick Settings</string>
    <string name="onboarding_tip_tile_body">Untuk menjeda dan mengaktifkan siaga secepat menyalakan senter.</string>

