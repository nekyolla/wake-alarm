<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Settings and keywords are backed up; message history never leaves the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/alarm_history.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/alarm_history.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
