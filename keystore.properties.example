# Salin menjadi keystore.properties (sudah di-.gitignore) lalu isi sesuai keystore rilis.
# Alternatif: set environment variable WAKEALARM_STORE_FILE, WAKEALARM_STORE_PASSWORD,
# WAKEALARM_KEY_ALIAS, WAKEALARM_KEY_PASSWORD (berguna untuk CI).
storeFile=wakealarm-release.jks
storePassword=
keyAlias=wakealarm
keyPassword=
